APP_NAME="SMARTSOURCING USA ACADEMY"
BRAND_NAME="SMARTSOURCING USA ACADEMY"
BRAND_SHORT_NAME="SSU Academy"
BRAND_AUTHOR="Smart Sourcing USA"
BRAND_TAGLINE="Enterprise training for teams and professionals within the construction industry."
BRAND_DESCRIPTION="SMARTSOURCING USA ACADEMY is a professional training and development platform of Smart Sourcing USA and is not a CHED-accredited higher education institution."
LEGAL_AGREEMENT_VERSION=2026-07-16

# SignWell student agreement (e-sign after registration)
# On Forge set these, then: php artisan migrate && php artisan config:clear
# Verify with: php artisan ssu:diagnose-signwell
SIGNWELL_ENABLED=false
SIGNWELL_API_KEY=
SIGNWELL_TEMPLATE_ID=dc1e7295-e1d8-4ed0-9988-2182837f37b8
# Must match the recipient/placeholder label on that SignWell template exactly
SIGNWELL_RECIPIENT_PLACEHOLDER=Student
SIGNWELL_TEST_MODE=true
SIGNWELL_WEBHOOK_SECRET=
# Webhook URL in SignWell: https://your-domain/signwell/webhook

# Local development defaults (change for UAT/staging/production)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# UAT / staging / production — use these instead of the values above:
# APP_ENV=staging
# APP_DEBUG=false
# APP_URL=https://academy-uat.example.com

# Used for password-reset links and payment return URLs (usually same as APP_URL)
FRONTEND_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssu_academy
DB_USERNAME=root
DB_PASSWORD=
# Leave empty on first upgrade from legacy unprefixed tables, run:
#   php artisan ssu:migrate-table-prefix
# Then set:
DB_TABLE_PREFIX=ssu_academy_

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ssu-academy.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15

# UAT: configure real SMTP before testing forgot-password / email verification.
# Local option: Mailpit/Mailhog on 127.0.0.1:1025 (see MAIL_HOST/PORT above).

STRIPE_TEST_MODE=true
STRIPE_SYNC_FROM_ENV=true

# Subscription billing (required for cancel/resubscribe webhooks locally — use Stripe CLI)
# stripe listen --forward-to localhost:8000/stripe/webhook
STRIPE_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_PORTAL_RETURN_URL=http://localhost:8000/dashboard/external/subscriptions

# Comma-separated domains that auto-register as internal employees (free course access)
EMPLOYEE_EMAIL_DOMAINS=smartsourcingusa.com

# Set by the web installer after first-time setup (1 = installed, installer routes locked)
SSU_ACADEMY_INSTALLED=

# Staging/UAT only: show test account shortcuts on the login page
# SSU_SHOW_TEST_ACCOUNTS=true

# One active login per account (Phase 1). Set false to disable.
SSU_SINGLE_SESSION=true

# --- UAT deploy steps (after copying this file to .env) ---
# 1. php artisan key:generate
# 2. Set DB_* credentials
# 3. php artisan migrate --force
# 4. php artisan storage:link
# 5. npm ci && npm run build
# 6. Create UAT users in admin (do not use local test passwords on shared servers)
# See TESTING_GUIDE.md for full UAT scenarios and account setup.

# Optional S3-compatible object storage (AWS S3 or Cloudflare R2).
# You can also configure these in Dashboard → Settings → Storage.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=ssa-academy-files
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Bunny Stream (lesson videos) — optional; can also configure in Dashboard → Settings → Bunny Stream
# BUNNY_STREAM_ENABLED=false
# BUNNY_STREAM_LIBRARY_ID=710026
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_CDN_HOSTNAME=vz-2d406c44-2e9.b-cdn.net
# BUNNY_STREAM_TOKEN_AUTH_KEY=
